{
  setup: {
    admin_username: "lemmy_admin"
    admin_password: "outpost-lemmy-pass"
    site_name: "Outpost Local"
  }
  database: {
    user: "lemmy"
    password: "password"
    host: "lemmy-postgres"
    port: 5432
    database: "lemmy"
    pool_size: 5
  }
  hostname: "localhost:8536"
  bind: "0.0.0.0"
  port: 8536
  federation: {
    enabled: false
  }
  registration_mode: "Open"
  pictrs: {
    url: "http://pictrs:8080/"
    api_key: "my-pictrs-key"
    image_mode: None
  }
}

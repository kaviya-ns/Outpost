# Application
APP_NAME=incubrix-longtail-distribution
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
SIMULATION_MODE=true
CONNECTOR_DISABLED=false

# Server
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Live demo (Render): set DEMO_API_KEY in dashboard; reviewers send X-Demo-Token header
DEMO_API_KEY=
RATE_LIMIT_PER_MINUTE=120

# Database (sqlite for local dev; postgres in compose)
DATABASE_URL=sqlite+aiosqlite:///./data/outpost.db
# DATABASE_URL=postgresql+asyncpg://outpost:outpost@postgres:5432/outpost

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=outpost
S3_PUBLIC_URL=http://localhost:9000/outpost
S3_USE_SSL=false
S3_ENABLED=true

# Job callbacks (optional)
CALLBACK_HMAC_SECRET=change-me-in-production

# AI adapters (mock by default)
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local platform instances (compose overrides)
DISCOURSE_MOCK_URL=http://mock-discourse:8081
DEVTO_MOCK_URL=http://mock-devto:8082
WEBHOOK_PARTNER_URL=http://mock-webhook:8083
LEMMY_BASE_URL=http://lemmy:8536
GHOST_URL=http://ghost:2368
GHOST_ADMIN_API_KEY=

# Certification
CERT_TEST_POST_TTL_MINUTES=10
CERTIFICATION_MAX_AGE_DAYS=30
RECERT_LEAD_DAYS=5
RECERT_CHECK_INTERVAL_SECONDS=3600
RECERT_SCHEDULER_ENABLED=true
TAILOR_ON_PUBLISH=true
MOCK_RULES_PAGE_URL=http://localhost:8080/rules/community-guidelines.txt
